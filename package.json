{
  "name": "skyrail",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node apps/local-service/server.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "start": "node apps/local-service/server.mjs",
    "setup:mac": "sh scripts/build-macos.sh",
    "service:install": "node scripts/install-service.mjs",
    "setup:session": "sh scripts/build-session-status.sh"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "react": "19.2.0",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "vite": "7.3.7",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "description": "Local-first Codex chat, live Mac window streaming, and human takeover",
  "repository": {
    "type": "git",
    "url": "https://github.com/eminentgu/skyrail.git"
  },
  "bugs": {
    "url": "https://github.com/eminentgu/skyrail/issues"
  }
}
