{
  "name": "skyrail",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node apps/local-service/server.mjs",
    "build": "tsc --noEmit && vite build",
